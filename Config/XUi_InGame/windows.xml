<configs>
  <append xpath="/windows">
    <window name="windowMiniMap" width="256" height="256" pos="20,-20" anchor="TopLeft" controller="MiniMapArea, MiniMap_Mod" visibility="always">
      <sprite depth="0" name="miniMapFrame" sprite="menu_empty" color="0,0,0,220" type="sliced" fillcenter="true" width="256" height="256" visible="false" />
      <rect name="toolbar" width="1" height="1" pos="0,0">
        <button name="playerIcon" width="1" height="1" visible="false" />
        <label name="playerPos" width="1" height="1" visible="false" />
        <button name="bedrollIcon" width="1" height="1" visible="false" />
        <label name="bedrollPos" width="1" height="1" visible="false" />
        <sprite name="cursorIcon" width="1" height="1" visible="false" />
        <label name="cursorPos" width="1" height="1" visible="false" />
        <button name="waypointIcon" width="1" height="1" visible="false" />
        <label name="waypointDistance" width="1" height="1" visible="false" />
      </rect>
      <button name="switchStaticMap" width="1" height="1" visible="false" />
      <combobox name="cbxStaticMapType" type="ComboBoxEnum`1[XUiC_MapArea+EStaticMapOverlay]" width="210" height="30" visible="false" />
      <rect name="mapView" depth="1" width="256" height="256" pos="0,0" snap="false">
        <sprite depth="1" name="backgroundMain" sprite="menu_empty" color="[black]" type="sliced" fillcenter="true" />
        <texture depth="2" name="mapViewTexture" width="256" height="256" pos="0,0" material="Materials/MaskableMainmap" />
        <sprite depth="3" width="40" height="40" pos="128,-128" pivot="center" name="crosshair" sprite="ui_game_symbol_map_player_arrow" foregroundlayer="true" />
        <panel name="clippingPanel" depth="4" width="256" height="256" pos="0,0" clipping="SoftClip" clippingsoftness="2,2" clippingsize="256,256" clippingcenter="128,-128" />
        <sprite depth="5" name="brightnessOverlay" sprite="menu_empty" color="0,0,0,0" type="sliced" fillcenter="true" width="256" height="256" />
      </rect>
    </window>
    <window name="windowMiniMapSettings" width="520" height="658" pos="-260,329" anchor="Center" controller="MiniMapSettings, MiniMap_Mod">
      <sprite depth="0" sprite="menu_empty" color="18,18,18,245" type="sliced" fillcenter="true" width="520" height="658" />
      <label depth="1" pos="24,-20" width="472" height="38" text="MINIMAP-OPTIONEN" font_size="30" justify="center" color="255,255,255,255" />

      <label pos="30,-78" width="260" height="32" text="Minimap" font_size="24" color="255,255,255,255" />
      <simplebutton name="miniMapToggle" pos="330,-74" width="160" height="34" caption="AN" font_size="22" />

      <label pos="30,-126" width="260" height="32" text="Zoomfaktor" font_size="24" color="255,255,255,255" />
      <simplebutton name="zoomDown" pos="330,-122" width="45" height="34" caption="-" font_size="24" />
      <label name="zoomValue" pos="380,-122" width="60" height="34" text="1.0x" font_size="22" justify="center" color="255,255,255,255" />
      <simplebutton name="zoomUp" pos="445,-122" width="45" height="34" caption="+" font_size="24" />

      <label pos="30,-174" width="260" height="32" text="Spielerpfeil" font_size="24" color="255,255,255,255" />
      <simplebutton name="arrowDown" pos="330,-170" width="45" height="34" caption="-" font_size="24" />
      <label name="arrowValue" pos="380,-170" width="60" height="34" text="40" font_size="22" justify="center" color="255,255,255,255" />
      <simplebutton name="arrowUp" pos="445,-170" width="45" height="34" caption="+" font_size="24" />

      <label pos="30,-222" width="260" height="32" text="Minimap-Größe" font_size="24" color="255,255,255,255" />
      <simplebutton name="sizeDown" pos="330,-218" width="45" height="34" caption="-" font_size="24" />
      <label name="sizeValue" pos="380,-218" width="60" height="34" text="256" font_size="22" justify="center" color="255,255,255,255" />
      <simplebutton name="sizeUp" pos="445,-218" width="45" height="34" caption="+" font_size="24" />

      <label pos="30,-270" width="260" height="32" text="Rahmen" font_size="24" color="255,255,255,255" />
      <simplebutton name="frameCycle" pos="330,-266" width="160" height="34" caption="Rahmenlos" font_size="20" />

      <label pos="30,-318" width="260" height="32" text="Mapform" font_size="24" color="255,255,255,255" />
      <simplebutton name="mapShape" pos="330,-314" width="160" height="34" caption="Quadrat" font_size="20" />

      <label pos="30,-366" width="260" height="32" text="Kriegsnebel" font_size="24" color="255,255,255,255" />
      <simplebutton name="fogToggle" pos="330,-362" width="160" height="34" caption="AN" font_size="20" />

      <label pos="30,-414" width="260" height="32" text="Helligkeit" font_size="24" color="255,255,255,255" />
      <simplebutton name="brightnessDown" pos="330,-410" width="45" height="34" caption="-" font_size="24" />
      <label name="brightnessValue" pos="380,-410" width="60" height="34" text="100%" font_size="22" justify="center" color="255,255,255,255" />
      <simplebutton name="brightnessUp" pos="445,-410" width="45" height="34" caption="+" font_size="24" />

      <label pos="30,-462" width="220" height="32" text="Position" font_size="24" color="255,255,255,255" />
      <simplebutton name="positionLeft" pos="238,-458" width="36" height="34" caption="&lt;" font_size="22" />
      <simplebutton name="positionUp" pos="278,-458" width="36" height="34" caption="^" font_size="22" />
      <simplebutton name="positionDown" pos="318,-458" width="36" height="34" caption="v" font_size="22" />
      <simplebutton name="positionRight" pos="358,-458" width="36" height="34" caption="&gt;" font_size="22" />
      <simplebutton name="positionReset" pos="398,-458" width="42" height="34" caption="R" font_size="20" />
      <simplebutton name="positionSave" pos="446,-458" width="42" height="34" caption="S" font_size="20" />

      <label pos="30,-506" width="220" height="32" text="Schrittweite" font_size="24" color="255,255,255,255" />
      <simplebutton name="positionStep1" pos="278,-502" width="64" height="34" caption="1 px" font_size="19" />
      <simplebutton name="positionStep10" pos="350,-502" width="64" height="34" caption="10 px" font_size="19" />
      <simplebutton name="positionStep100" pos="422,-502" width="68" height="34" caption="100 px" font_size="18" />

      <label pos="30,-552" width="270" height="28" text="Öffnen/Schließen: F5" font_size="18" color="180,180,180,255" />
      <simplebutton name="miniMapClose" pos="180,-586" width="160" height="40" caption="SCHLIESSEN" font_size="21" />
    </window>
  </append>
</configs>
